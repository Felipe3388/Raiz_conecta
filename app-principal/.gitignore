# ==========================================
# 📦 DEPENDÊNCIAS (Em todas as pastas)
# ==========================================
node_modules/
.pnp
.pnp.*
# ==========================================
# 🔐 SEGURANÇA (NUNCA SUBIR PARA O GITHUB)
# ==========================================
.env
*.pem
# ==========================================
# 🚀 NEXT.JS (app-principal)
# ==========================================
.next/
out/
next-env.d.ts
# ==========================================
# 🏗️ BUILDS DO SERVIDOR
# ==========================================
dist/
build/
# ==========================================
# 🗄️ PRISMA
# ==========================================
# O banco é PostgreSQL (Neon). Bancos SQLite locais e arquivos enviados em testes não vão para o Git.
*.db
*.db-journal
public/uploads/

# ==========================================
# 🛠️ LOGS E SISTEMA OPERACIONAL
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store   *.tsbuildinfo
