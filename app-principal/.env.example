# Copie para .env.local (desenvolvimento) ou configure no painel do Vercel (produção).

# PostgreSQL (Neon, Supabase...)
DATABASE_URL="postgresql://usuario:senha@host:5432/raizconecta?sslmode=require"

# OBRIGATÓRIO em produção: mínimo 32 caracteres, aleatório. Assina os tokens de login e gera os códigos de etiqueta
# das balanças. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# OBRIGATÓRIO para criar o primeiro administrador em /api/setup-admin (8+ caracteres, maiúscula, minúscula, número e símbolo)
ADMIN_SENHA_INICIAL=""

# Cloudinary (fotos de produtos, sugestões e documentos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Microsserviço de e-mails (app-node). Vazio = o site funciona sem enviar e-mails.
MICROSERVICE_URL=""

# Origem permitida para o app mobile na versão web (CORS). Vazio = qualquer origem ("*"); em produção prefira a origem exata.
CORS_ALLOWED_ORIGIN=""
