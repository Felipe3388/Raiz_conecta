# Copie este arquivo para .env

# true  = telas com dados simulados, sem precisar da API (bom para ver o app)
# false = usa a API real (EXPO_PUBLIC_API_URL): login, cadastro, catálogo, sugestão de produto, perfil e balança
#         (vínculo e peso ao vivo do módulo ESP32).
#         Propostas, entregas, registro da pesagem e preços seguem simulados até o site ter essas APIs.
EXPO_PUBLIC_USE_MOCKS=true

# URL base da API (app-principal), usada quando EXPO_PUBLIC_USE_MOCKS=false
# Emulador Android: http://10.0.2.2:3000
# Dispositivo físico: http://<IP-da-sua-máquina>:3000 (nunca "localhost")
EXPO_PUBLIC_API_URL=http://localhost:3000

# Atenção: este arquivo é só do app mobile. Não copie o .env do app-principal
# (DATABASE_URL, JWT_SECRET, CLOUDINARY_*...): variáveis EXPO_PUBLIC_* ficam
# visíveis dentro do app instalado, então segredos nunca entram aqui.
